rules_version = '2';

// pulseLeaderboard/{uid} holds the guest's highest completed-run score as an integer.
// Authentication scopes writes to the guest's own document. Scores originate in the game client.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidScore() {
      let entry = request.resource.data;
      return entry.keys().hasAll(['score'])
        && entry.keys().hasOnly(['score'])
        && entry.score is int
        && entry.score >= 0;
    }

    match /pulseLeaderboard/{uid} {
      allow get: if isOwner(uid);
      allow list: if isAuthenticated() && request.query.limit <= 10;
      allow create: if isOwner(uid) && isValidScore();
      allow update: if isOwner(uid) && isValidScore()
        && request.resource.data.score > resource.data.score;
    }
  }
}
